# Configuración de Apache para la raíz del sitio (XAMPP / InfinityFree).

Options -Indexes
DirectoryIndex index.html

# ── Archivos que no deben ser públicos ──────────────────────────────────────
<FilesMatch "(\.(sql|md|bat|sh|log|ini|example)|^server\.js|^generate-icons\.js|^resize-icon\.js|^\.git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Bloquear la carpeta .git si se sube por error
    RewriteRule (^|/)\.git(/|$) - [F,L]
</IfModule>

# ── Cabeceras de seguridad ──────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>

# ── Caché HTTP ──────────────────────────────────────────────────────────────
# sw.js nunca se cachea: si el navegador lo cachea, no detecta nuevas versiones.
<IfModule mod_headers.c>
    <FilesMatch "^(sw\.js|index\.html|manifest\.json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|webp|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/webp .webp
</IfModule>
