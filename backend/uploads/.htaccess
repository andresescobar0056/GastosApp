# Carpeta de imágenes subidas por los usuarios.
# Solo se sirven imágenes; nunca se ejecuta código ni se listan archivos.

Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phps .phar

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
    <FilesMatch "\.(jpe?g|png|webp)$">
        Require all granted
    </FilesMatch>
</IfModule>

# Apache 2.2 (compatibilidad)
<IfModule !mod_authz_core.c>
    Order Deny,Allow
    Deny from all
    <FilesMatch "\.(jpe?g|png|webp)$">
        Allow from all
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'"
</IfModule>
