# Carpeta de imágenes subidas por los usuarios.
# Solo se pueden abrir imágenes (.jpg/.jpeg/.png/.webp); cualquier otro archivo da 403.
# (El backend solo guarda aquí imágenes validadas con nombres aleatorios.)
#
# Se usan únicamente directivas permitidas en hostings compartidos como InfinityFree:
# php_flag, RemoveHandler u Options -ExecCGI provocan error 500 allí.

Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
    <FilesMatch "\.(jpe?g|png|webp)$">
        Require all granted
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    Order Deny,Allow
    Deny from all
    <FilesMatch "\.(jpe?g|png|webp)$">
        Allow from all
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
