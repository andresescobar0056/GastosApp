# Netlify headers — control de caché HTTP

# sw.js NUNCA debe ser cacheado por el browser ni por el CDN de Netlify.
# Si el browser cachea sw.js, jamás detectará nuevos deploys.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# manifest.json tampoco debe cachearse agresivamente
/manifest.json
  Cache-Control: no-cache

# index.html siempre fresco (el SW lo maneja offline)
/index.html
  Cache-Control: no-cache

# JS y CSS: el SW los maneja con Stale-While-Revalidate.
# El HTTP cache puede guardarlos 1 hora como máximo para no conflictuar.
/js/*
  Cache-Control: public, max-age=3600

/css/*
  Cache-Control: public, max-age=3600

# Imágenes y assets: se pueden cachear más tiempo (cambian poco)
/assets/*
  Cache-Control: public, max-age=604800, immutable
